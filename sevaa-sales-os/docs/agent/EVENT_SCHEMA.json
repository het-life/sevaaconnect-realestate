{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEVAA Agent Task Result Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "event_type",
    "agent_id",
    "task_id",
    "outcome",
    "validated",
    "duration_ms",
    "cost_inr",
    "human_interruptions",
    "evidence_level_before",
    "evidence_level_after",
    "rework_required",
    "notes"
  ],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "event_type": {"const": "task_result"},
    "agent_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["success", "partial_success", "failure", "blocked_external", "cancelled"]},
    "validated": {"type": "boolean"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "cost_inr": {"type": "number", "minimum": 0},
    "human_interruptions": {"type": "integer", "minimum": 0},
    "evidence_level_before": {"type": "number", "minimum": 0, "maximum": 9},
    "evidence_level_after": {"type": "number", "minimum": 0, "maximum": 9},
    "rework_required": {"type": "boolean"},
    "notes": {"type": "string", "maxLength": 1000}
  }
}
