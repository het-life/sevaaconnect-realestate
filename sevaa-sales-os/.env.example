# Optional override. Local default is ./data/sevaa.db; container default is /data/sevaa.db.
SEVAA_DB_PATH=./data/sevaa.db

# OpenClaw/client base URL. Change to the deployed HTTPS origin after launch.
SEVAA_BASE_URL=http://127.0.0.1:8000

# Leave founder/automation empty only for local single-user development.
# Set both to different high-entropy values in any shared or deployed environment.
SEVAA_FOUNDER_TOKEN=
SEVAA_AUTOMATION_TOKEN=

# Inbound lead webhook routes stay disabled until this separate secret is set.
SEVAA_WEBHOOK_TOKEN=

# Emergency/local compatibility only. Keep 0 in shared production.
SEVAA_ALLOW_LEGACY_V1=0

# Local Docker Compose binding. Keep loopback unless deliberately fronted by HTTPS.
SEVAA_BIND_HOST=127.0.0.1
SEVAA_PORT=8000

# Process-local abuse controls. The current single-instance deployment uses these
# directly; move enforcement to shared infrastructure before horizontal scaling.
SEVAA_RATE_LIMIT_WINDOW_SECONDS=60
SEVAA_RATE_LIMIT_PUBLIC_PER_WINDOW=10
SEVAA_RATE_LIMIT_WEBHOOK_PER_WINDOW=30
SEVAA_RATE_LIMIT_SERVICE_PER_WINDOW=300

# Optional real payment integration. Leave blank until founder-authorized setup.
# Never commit real values. Provider notifications remain disabled by application code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Hosting platforms such as Railway inject PORT automatically. Do not hardcode it
# in production; the container entrypoint consumes PORT when provided.
