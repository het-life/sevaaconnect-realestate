# Optional override. Default is ./data/sevaa.db
SEVAA_DB_PATH=./data/sevaa.db

# Leave founder/automation empty only for local single-user development.
# Set both in any shared or deployed environment.
SEVAA_FOUNDER_TOKEN=
SEVAA_AUTOMATION_TOKEN=

# Inbound lead webhook routes stay disabled until this is set.
# Use a separate secret; never reuse founder credentials.
SEVAA_WEBHOOK_TOKEN=
